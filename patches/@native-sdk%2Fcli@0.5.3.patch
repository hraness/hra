+test "staging uses one verified placeholder and directory replacement is rollback-shaped" {
+    const cwd = std.Io.Dir.cwd();
+    const root = ".zig-cache/test-pinned-package-replacement";
+    cwd.deleteTree(std.testing.io, root) catch {};
+    defer cwd.deleteTree(std.testing.io, root) catch {};
+    try cwd.createDirPath(std.testing.io, root ++ "/source");
+    try cwd.createDirPath(std.testing.io, root ++ "/package/frontend/dist");
+    try cwd.writeFile(std.testing.io, .{ .sub_path = root ++ "/source/library.sf3", .data = "12345678" });
+    try cwd.writeFile(std.testing.io, .{ .sub_path = root ++ "/package/frontend/dist/library.sf3", .data = "" });
+    try cwd.writeFile(std.testing.io, .{ .sub_path = root ++ "/package/frontend/dist/asset-manifest.zon", .data = "placeholder" });
+
+    const pin: PinnedOversizedAsset = .{ .bundle_path = "library.sf3", .byte_len = 8, .hash = zig_assets.sha256("12345678") };
+    const options: BundleOptions = .{ .limits = .{ .maximum_file_bytes = 4, .maximum_total_bytes = 32 }, .pinned_oversized_assets = &.{pin} };
+    try cwd.createDirPath(std.testing.io, root ++ "/stage");
+    _ = try bundleConfigured(std.testing.allocator, std.testing.io, root ++ "/source", root ++ "/stage", options);
+    var placeholder = try cwd.openFile(std.testing.io, root ++ "/stage/library.sf3", .{ .mode = .read_write, .follow_symlinks = false });
+    try placeholder.setLength(std.testing.io, 0);
+    placeholder.close(std.testing.io);
+    try cwd.deleteFile(std.testing.io, root ++ "/stage/asset-manifest.zon");
+    var staged_placeholder = try cwd.openFile(std.testing.io, root ++ "/stage/library.sf3", .{});
+    defer staged_placeholder.close(std.testing.io);
+    try std.testing.expectEqual(@as(u64, 0), try staged_placeholder.length(std.testing.io));
+
+    const replacement = root ++ "/package/frontend/dist.oprte-verified-new";
+    _ = try bundleConfigured(std.testing.allocator, std.testing.io, root ++ "/source", replacement, options);
+    try replaceDirectory(std.testing.io, root ++ "/package/frontend/dist", replacement, root ++ "/package/frontend/dist.oprte-placeholder-old");
+    var installed = try cwd.openFile(std.testing.io, root ++ "/package/frontend/dist/library.sf3", .{});
+    defer installed.close(std.testing.io);
+    var bytes: [8]u8 = undefined;
+    const len = try installed.readPositionalAll(std.testing.io, &bytes, 0);
