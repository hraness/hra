+fn hashFile(io: std.Io, file: std.Io.File) !zig_assets.Hash {
+    var buffer: [64 * 1024]u8 = undefined;
+    var reader = file.reader(io, &buffer);
+    var transfer: [64 * 1024]u8 = undefined;
+    var hasher = std.crypto.hash.sha2.Sha256.init(.{});
+    while (true) {
+        const read_bytes = try reader.interface.readSliceShort(&transfer);
+        if (read_bytes == 0) break;
+        hasher.update(transfer[0..read_bytes]);
+    }
+    var digest: [zig_assets.Hash.digest_len]u8 = undefined;
+    hasher.final(&digest);
+    return zig_assets.Hash.init(digest);
+}
+
+fn hashRepeatedByte(byte: u8, byte_len: u64) zig_assets.Hash {
+    var bytes: [64 * 1024]u8 = undefined;
+    @memset(&bytes, byte);
+    var hasher = std.crypto.hash.sha2.Sha256.init(.{});
+    var remaining = byte_len;
+    while (remaining != 0) {
+        const update_len: usize = @intCast(@min(remaining, bytes.len));
+        hasher.update(bytes[0..update_len]);
+        remaining -= update_len;
+    }
+    var digest: [zig_assets.Hash.digest_len]u8 = undefined;
+    hasher.final(&digest);
+    return zig_assets.Hash.init(digest);
+}
