+}
+
+fn replacePackagedAssets(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    source_path: []const u8,
+    packaged_assets_path: []const u8,
+    pin: PinnedOversizedAsset,
+) !void {
+    const replacement_path = try std.fmt.allocPrint(allocator, "{s}.oprte-verified-new", .{packaged_assets_path});
+    defer allocator.free(replacement_path);
+    const backup_path = try std.fmt.allocPrint(allocator, "{s}.oprte-placeholder-old", .{packaged_assets_path});
+    defer allocator.free(backup_path);
+    try deleteTreeIfPresent(io, replacement_path);
+    try deleteTreeIfPresent(io, backup_path);
+    errdefer std.Io.Dir.cwd().deleteTree(io, replacement_path) catch {};
+
+    _ = try bundleWithPinnedOversizedAssets(allocator, io, source_path, replacement_path, &.{pin});
+    try replaceDirectory(io, packaged_assets_path, replacement_path, backup_path);
+}
+
+fn replaceDirectory(io: std.Io, destination_path: []const u8, replacement_path: []const u8, backup_path: []const u8) !void {
+    const cwd = std.Io.Dir.cwd();
+    const destination_stat = statDirectoryNoFollow(io, destination_path) catch return error.InvalidPackagedAssetsDirectory;
+    if (destination_stat.kind != .directory) return error.InvalidPackagedAssetsDirectory;
+    const replacement_stat = statDirectoryNoFollow(io, replacement_path) catch return error.InvalidPackagedAssetsDirectory;
+    if (replacement_stat.kind != .directory) return error.InvalidPackagedAssetsDirectory;
+
+    try cwd.rename(destination_path, cwd, backup_path, io);
+    var backup_moved = true;
+    var replacement_moved = false;
+    errdefer {
+        if (replacement_moved) cwd.deleteTree(io, destination_path) catch {};
+        if (backup_moved) cwd.rename(backup_path, cwd, destination_path, io) catch {};
+    }
+
+    const backup_stat = statDirectoryNoFollow(io, backup_path) catch return error.PackagedAssetsChangedDuringReplacement;
+    if (!sameDirectoryIdentity(destination_stat, backup_stat)) return error.PackagedAssetsChangedDuringReplacement;
+
+    try cwd.rename(replacement_path, cwd, destination_path, io);
+    replacement_moved = true;
+    const installed_stat = statDirectoryNoFollow(io, destination_path) catch return error.PackagedAssetsChangedDuringReplacement;
+    if (!sameDirectoryIdentity(replacement_stat, installed_stat)) return error.PackagedAssetsChangedDuringReplacement;
+
+    cwd.deleteTree(io, backup_path) catch return error.PackagedAssetsBackupCleanupFailed;
+    backup_moved = false;
+}
+
+fn sameDirectoryIdentity(before: std.Io.File.Stat, after: std.Io.File.Stat) bool {
+    return before.inode == after.inode and before.kind == .directory and after.kind == .directory;
+}
+
+fn statDirectoryNoFollow(io: std.Io, path: []const u8) !std.Io.File.Stat {
+    var directory = try std.Io.Dir.cwd().openDir(io, path, .{ .follow_symlinks = false });
+    defer directory.close(io);
+    return directory.stat(io);
+}
+
+fn deleteTreeIfPresent(io: std.Io, path: []const u8) !void {
+    try std.Io.Dir.cwd().deleteTree(io, path);
