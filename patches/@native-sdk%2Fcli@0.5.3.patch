+/// Runs a package command against a private placeholder tree and replaces only
+/// its packaged asset directory with a fully verified tree before succeeding.
+/// The command must package unsigned; signing belongs after this mutation.
+pub fn main(init: std.process.Init) !void {
+    var arguments = std.process.Args.Iterator.init(init.minimal.args);
+    _ = arguments.next();
+    const mode = arguments.next() orelse return error.InvalidArguments;
+    if (!std.mem.eql(u8, mode, "package-with-pinned-asset")) return error.InvalidArguments;
+
+    const source_path = arguments.next() orelse return error.InvalidArguments;
+    const staging_path = arguments.next() orelse return error.InvalidArguments;
+    const packaged_assets_path = arguments.next() orelse return error.InvalidArguments;
+    const bundle_path = arguments.next() orelse return error.InvalidArguments;
+    const byte_len_text = arguments.next() orelse return error.InvalidArguments;
+    const hash_text = arguments.next() orelse return error.InvalidArguments;
+    const separator = arguments.next() orelse return error.InvalidArguments;
+    if (!std.mem.eql(u8, separator, "--")) return error.InvalidArguments;
+
+    var command: std.ArrayList([]const u8) = .empty;
+    defer command.deinit(init.gpa);
+    while (arguments.next()) |argument| try command.append(init.gpa, argument);
+    if (command.items.len == 0) return error.InvalidArguments;
+
+    const pin: PinnedOversizedAsset = .{
+        .bundle_path = bundle_path,
+        .byte_len = try std.fmt.parseInt(u64, byte_len_text, 10),
+        .hash = try zig_assets.Hash.parseHex(hash_text),
+    };
+    try packageWithPinnedAsset(
+        init.gpa,
+        init.io,
+        init.environ_map,
+        source_path,
+        staging_path,
+        packaged_assets_path,
+        pin,
+        command.items,
+    );
+}
+
+fn packageWithPinnedAsset(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    environ_map: *const std.process.Environ.Map,
+    source_path: []const u8,
+    staging_path: []const u8,
+    packaged_assets_path: []const u8,
+    pin: PinnedOversizedAsset,
+    command: []const []const u8,
+) !void {
+    try validatePackageCommand(command, staging_path);
+    const cwd = std.Io.Dir.cwd();
+    deleteTreeIfPresent(io, staging_path) catch return error.StagingCleanupFailed;
+    try cwd.createDirPath(io, staging_path);
+    errdefer cwd.deleteTree(io, staging_path) catch {};
+    // `prepare-package-output` removes the exact prior app before this helper
+    // starts. If anything here fails, remove the packaged frontend as well so
+    // a partial or pre-existing artifact can never look launchable.
+    errdefer cwd.deleteTree(io, packaged_assets_path) catch {};
+
+    try prepareStagingBundle(allocator, io, source_path, staging_path, pin);
+    var child = try std.process.spawn(io, .{
+        .argv = command,
+        .environ_map = environ_map,
+        .stdin = .inherit,
+        .stdout = .inherit,
+        .stderr = .inherit,
+    });
+    const term = try child.wait(io);
+    switch (term) {
+        .exited => |code| if (code != 0) return error.PackageCommandFailed,
+        else => return error.PackageCommandFailed,
+    }
+
+    try replacePackagedAssets(allocator, io, source_path, packaged_assets_path, pin);
+    cwd.deleteTree(io, staging_path) catch return error.StagingCleanupFailed;
