+    defer placeholder.close(io);
+    const before = try placeholder.stat(io);
+    if (before.kind != .file or before.nlink != 1 or before.size != pin.byte_len) return error.InvalidPinnedPlaceholder;
+    try placeholder.setLength(io, 0);
+    const after = try placeholder.stat(io);
+    if (before.inode != after.inode or after.kind != .file or after.nlink != 1 or after.size != 0) return error.InvalidPinnedPlaceholder;
