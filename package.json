{
  "name": "hra",
  "version": "0.1.0",
  "description": "A persistent Codex CLI for isolated accounts, live sessions, and encrypted device sync.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "hra": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:site",
    "build:cli": "bun build ./src/cli.ts --target=bun --outdir=dist/cli",
    "build:site": "bun ./scripts/build-site.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build:site -- --check && bun run build && bun run check:package",
    "check:package": "bun run test:package-policy && bun ./scripts/check-package.ts",
    "acceptance:live": "bun ./scripts/live-acceptance.ts",
    "hosted:bootstrap": "bun ./scripts/bootstrap-hosted-sync.ts",
    "hosted:admission": "bun ./scripts/manage-hosted-admission.ts",
    "hosted:configure": "bun ./scripts/configure-hosted-sync.ts",
    "hosted:deploy": "bun ./scripts/deploy-hosted-sync.ts",
    "hosted:invites": "bun ./scripts/manage-hosted-invites.ts",
    "operator:migrate-legacy-secrets": "bun ./scripts/migrate-legacy-secrets.ts",
    "release:canonical-alias": "bun ./scripts/current-project-alias-release.ts",
    "lint": "eslint .",
    "start": "bun ./src/cli.ts",
    "test": "bun test --isolate --max-concurrency=1",
    "test:simulation": "bun test ./src/cloud/deterministic-authority-simulation.test.ts --isolate --max-concurrency=1",
    "test:package-policy": "sh -c 'umask 077; exec bun test ./scripts/package-policy.test.ts --isolate --max-concurrency=1'",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/AGENTS.md",
    "!src/cloud/inviteAuthority.ts",
    "!src/cloud/testAssertions.ts",
    "!src/storage/legacy-secret-migration.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/hra.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/hra/issues"
  },
  "homepage": "https://hra.sh",
  "keywords": [
    "bun",
    "chatgpt",
    "cli",
    "codex",
    "multi-account"
  ],
  "dependencies": {
    "@openai/codex": "0.149.0",
    "convex": "1.45.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@eslint/js": "9.34.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.2.1",
    "@hraness/site-footer": "github:hraness/site-footer#v0.3.1",
    "@hraness/ui": "github:hraness/ui#v0.4.10",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "convex-test": "0.0.56",
    "eslint": "9.34.0",
    "fast-check": "4.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
