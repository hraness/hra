{
  "name": "hra",
  "version": "0.1.0",
  "description": "A persistent Codex CLI for isolated accounts, live sessions, and encrypted device sync.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "hra": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/AGENTS.md",
    "!src/cloud/testAssertions.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/hra.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/hra/issues"
  },
  "homepage": "https://hra.sh",
  "keywords": [
    "bun",
    "chatgpt",
    "cli",
    "codex",
    "multi-account"
  ],
  "scripts": {
    "build": "bun run build:cli && bun run build:site",
    "build:cli": "bun build ./src/cli.ts --target=bun --outdir=dist/cli",
    "build:site": "bun ./scripts/build-site.ts",
    "check": "bun run lint && bun run typecheck && bun test && bun run build:site -- --check && bun run build && bun run check:package",
    "check:package": "bun ./scripts/check-package.ts",
    "lint": "eslint .",
    "start": "bun ./src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex": "0.149.0",
    "convex": "1.45.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@eslint/js": "9.34.0",
    "@types/bun": "1.3.14",
    "convex-test": "0.0.56",
    "eslint": "9.34.0",
    "fast-check": "4.3.0",
    "react": "19.2.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
