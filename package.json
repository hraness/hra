{
  "name": "@hraness/hra",
  "version": "0.6.0",
  "description": "Control plane for Codex and Claude Code in current source; v0.6.0 is release-ready. Run provider sessions side by side through one durable CLI.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "hra": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:site",
    "build:app": "NODE_ENV=production vite build --config app/vite.config.ts",
    "build:cli": "bun build ./src/cli.ts --target=bun --outdir=dist/cli",
    "build:site": "bun ./scripts/build-site.ts",
    "check": "bun run check:install-pins && bun run check:security-primitives && bun run lint && bun run typecheck && bun run test && bun run build:site -- --check && bun run build:app && bun run build && bun run check:package",
    "check:package": "bun run test:package-policy && bun ./scripts/check-package.ts",
    "check:security-primitives": "bun ./scripts/check-security-primitives.ts",
    "check:install-pins": "bun ./scripts/check-install-pins.ts",
    "codex:bump": "bun ./scripts/codex-bump.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "cloud-efficiency:apply": "bun run ./plugins/hra-cloud-efficiency/skills/hra-cloud-efficiency/scripts/bootstrap.ts --apply",
    "cloud-efficiency:check": "bun run ./plugins/hra-cloud-efficiency/skills/hra-cloud-efficiency/scripts/bootstrap.ts --check",
    "local-efficiency:apply": "bun run ./plugins/hra-local-efficiency/skills/hra-local-efficiency/scripts/bootstrap.ts --apply",
    "local-efficiency:check": "bun run ./plugins/hra-local-efficiency/skills/hra-local-efficiency/scripts/bootstrap.ts --check",
    "acceptance:live": "bun ./scripts/live-acceptance.ts",
    "hosted:bootstrap": "bun ./scripts/bootstrap-hosted-sync.ts",
    "hosted:admission": "bun ./scripts/manage-hosted-admission.ts",
    "hosted:configure": "bun ./scripts/configure-hosted-sync.ts",
    "hosted:deploy": "bun ./scripts/deploy-hosted-sync.ts",
    "hosted:invites": "bun ./scripts/manage-hosted-invites.ts",
    "hosted:replace-target": "bun ./scripts/replace-hosted-convex-target.ts",
    "hosted:status": "bun ./scripts/hosted-status.ts",
    "install-pins:update": "bun ./scripts/check-install-pins.ts --update",
    "operator:migrate-legacy-secrets": "bun ./scripts/migrate-legacy-secrets.ts",
    "release:tag": "bun ./scripts/create-release-tag.ts",
    "lint": "eslint .",
    "start": "bun ./src/cli.ts",
    "test": "bun test ./scripts --isolate --max-concurrency=1 && bun run test:local-efficiency-plugin && bun run test:cloud-efficiency-plugin && bun test ./src --isolate --max-concurrency=1 && bun test ./convex ./site --isolate --max-concurrency=1 && bun test ./app --isolate --max-concurrency=1",
    "test:cloud-efficiency-plugin": "bun test ./plugins/hra-cloud-efficiency/skills/hra-cloud-efficiency/scripts --isolate --max-concurrency=1",
    "test:local-efficiency-plugin": "bun test ./plugins/hra-local-efficiency/skills/hra-local-efficiency/scripts --isolate --max-concurrency=1",
    "test:simulation": "bun test ./src/cloud/deterministic-authority-simulation.test.ts --isolate --max-concurrency=1",
    "test:package-policy": "sh -c 'umask 077; exec bun test ./scripts/package-policy.test.ts --isolate --max-concurrency=1'",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/AGENTS.md",
    "!src/cloud/inviteAuthority.ts",
    "!src/cloud/testAssertions.ts",
    "!src/storage/legacy-secret-migration.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/hra.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/hra/issues"
  },
  "homepage": "https://hra.sh",
  "keywords": [
    "bun",
    "chatgpt",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "multi-account"
  ],
  "dependencies": {
    "@hraness/oh": "0.2.7",
    "@openai/codex": "0.153.2",
    "convex": "1.45.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@eslint/js": "9.34.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.3.0",
    "@hraness/posthog": "github:hraness/posthog#v0.1.2",
    "@hraness/site-footer": "github:hraness/site-footer#v0.4.6",
    "@hraness/ui": "github:hraness/ui#v0.4.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "convex-test": "0.0.56",
    "eslint": "9.34.0",
    "fast-check": "4.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sigstore": "4.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6"
  }
}
