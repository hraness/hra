{
  "extends": "@hra-internal/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowJs": false,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["bun"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
