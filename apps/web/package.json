{
  "name": "@hraness/hra-web",
  "version": "0.1.0",
  "private": true,
  "description": "HRA web task control plane",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/hra.git",
    "directory": "apps/web"
  },
  "homepage": "https://hra.sh",
  "bugs": {
    "url": "https://github.com/hraness/hra/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev --tail-logs disable --start 'bun run dev:web'",
    "dev:web": "next dev --webpack",
    "dev:direct": "vite --config direct/vite.config.ts",
    "convex:init": "CONVEX_AGENT_MODE=anonymous convex init",
    "convex:dev": "CONVEX_AGENT_MODE=anonymous convex dev --tail-logs disable",
    "convex:dev:once": "CONVEX_AGENT_MODE=anonymous convex dev --once --tail-logs disable",
    "build": "bun run scripts/vercel-build.ts --run-app-build --production-deployment benevolent-akita-439",
    "build:app": "next build --webpack && bun run check:production-icons && bun run check:direct-boundary",
    "build:direct": "bun run direct/build.ts",
    "check:direct-boundary": "bun run direct/check-production-boundary.ts",
    "check:production-icons": "bun run production-icon-boundary.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test ./*.test.ts ./app ./convex ./direct ./scripts",
    "test:direct": "bun test ./direct",
    "test:local": "bun run tests/local-convex.ts",
    "test:local:human": "bun run ../../scripts/check-resource-scheduler.ts --mode=exclusive --label=HRA-signed-human-local-acceptance -- bun run test:local:human:uncoordinated",
    "test:local:human:uncoordinated": "bun run tests/human-local-runner.ts",
    "test:local:convex": "bun run ../../scripts/check-resource-scheduler.ts --mode=exclusive --label=HRA-local-Convex-acceptance -- bun run test:local:convex:uncoordinated",
    "test:local:convex:uncoordinated": "bun run tests/run-local-convex.ts",
    "test:property": "bun test ./app/*.property.test.ts ./convex/*.property.test.ts ./direct/*.property.test.ts",
    "verify:direct": "bun run ../../scripts/check-resource-scheduler.ts --mode=exclusive --label=HRA-web-Direct-verification -- bun run verify:direct:uncoordinated",
    "verify:direct:uncoordinated": "bun run direct/verify-browser.ts",
    "provider:create-convex-deploy-key": "bun run scripts/create-convex-deploy-key.ts",
    "verify:receipt-provider": "bun run scripts/verify-receipt-provider.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hra-internal/brand-ui": "workspace:*",
    "@hra-internal/convex": "workspace:*",
    "@hra-internal/schema": "workspace:*",
    "@hraness/agent-tasks-domain": "workspace:*",
    "@hraness/agent-tasks-protocol": "workspace:*",
    "@hra-internal/codex-app-sdk": "workspace:*",
    "@hraness/vercel-delivery": "catalog:",
    "@hraness/web-discovery": "catalog:",
    "@workos-inc/authkit-nextjs": "catalog:",
    "@workos-inc/node": "catalog:",
    "convex": "catalog:",
    "jose": "catalog:",
    "next": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@hra-internal/design-kit": "workspace:*",
    "@hra-internal/eslint-config": "workspace:*",
    "@hra-internal/test": "workspace:*",
    "@hra-internal/typescript-config": "workspace:*",
    "@hraness/agent-tasks-ui": "workspace:*",
    "@hraness/direct": "catalog:",
    "@hraness/types": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "convex-test": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
