# Generated by anonymous local Convex initialization.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Hraness suite account origin. It must match the checked OIDC consumer
# HRA contract exactly; arbitrary origins fail closed.
NEXT_PUBLIC_SITE_URL=https://hra.sh

# Server-only OIDC cookie custody and the non-secret receipt key selector.
# Generate an independent random cookie secret of at least 32 bytes for each
# environment. The cookie secret belongs only in the web host. Set the same
# receipt version selector in the web host and HRA Convex environment.
SUITE_OIDC_COOKIE_SECRET=
SUITE_IDENTITY_RECEIPT_KEY_VERSION=v1

# Set these only in the Convex deployment environment. Values are canonical
# base64url encodings of independent 32-byte keys.
# The hosted fingerprint current pair is required for browser writes. During
# rotation, retain the previous pair until every open row on that version has
# settled. Missing, malformed, or prematurely retired pairs fail closed.
HRA_HOSTED_MUTATION_FINGERPRINT_KEY_CURRENT=
HRA_HOSTED_MUTATION_FINGERPRINT_KEY_CURRENT_VERSION=v1
HRA_HOSTED_MUTATION_FINGERPRINT_KEY_PREVIOUS=
HRA_HOSTED_MUTATION_FINGERPRINT_KEY_PREVIOUS_VERSION=
# Existing deployments may retain the exact OPRTE_* values as fallbacks.
# When both spellings are present, every corresponding value must be identical
# or the keyring fails closed. Do not rotate or regenerate a key for the rename.
# OPRTE_HOSTED_MUTATION_FINGERPRINT_KEY_CURRENT=
# OPRTE_HOSTED_MUTATION_FINGERPRINT_KEY_CURRENT_VERSION=v1
# OPRTE_HOSTED_MUTATION_FINGERPRINT_KEY_PREVIOUS=
# OPRTE_HOSTED_MUTATION_FINGERPRINT_KEY_PREVIOUS_VERSION=

# Session sync is fail-closed unless this exact Convex-only flag is true. Keep
# it false until the source-bound production deployment, WorkOS
# identity, device enrollment, desktop public coordinates, and public route
# readbacks have all passed for the same release.
HRA_SESSION_SYNC_ENABLED=false
# OPRTE_SESSION_SYNC_ENABLED=false
TASKCTL_CREDENTIAL_PEPPER_CURRENT=
TASKCTL_CREDENTIAL_PEPPER_CURRENT_VERSION=v1
TASKCTL_CREDENTIAL_PEPPER_PREVIOUS=
TASKCTL_CREDENTIAL_PEPPER_PREVIOUS_VERSION=
TASKCTL_ENROLLMENT_PEPPER_CURRENT=
TASKCTL_ENROLLMENT_PEPPER_CURRENT_VERSION=v1
TASKCTL_ENROLLMENT_PEPPER_PREVIOUS=
TASKCTL_ENROLLMENT_PEPPER_PREVIOUS_VERSION=

# Set only with `convex env set`, never in Vercel or a browser-visible variable.
# The selected HRA deployment needs a product-scoped keyring. Development uses
# a separate local keyring.
# During rotation, add the new version, switch SUITE_IDENTITY_RECEIPT_KEY_VERSION,
# and retain the old version through the maximum five-minute receipt lifetime.
# {"version":1,"keys":[{"product":"hra","environment":"production","keyVersion":"v1","secret":"<at-least-32-random-bytes>"}]}
SUITE_IDENTITY_LINK_KEYS=

# Local fixture functions additionally require a matching synthetic identity.
TASKCTL_LOCAL_FIXTURES_ENABLED=false
TASKCTL_LOCAL_FIXTURE_ISSUER=
TASKCTL_LOCAL_FIXTURE_JWKS_URL=
TASKCTL_LOCAL_FIXTURE_SUBJECT=

# Optional until live WorkOS development credentials are configured.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_OWNER_ROLE_SLUG=admin
WORKOS_WEBHOOK_SECRET=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Local signed-auth acceptance only. These overrides are rejected by Convex
# unless fixtures are enabled and the hostname is exact loopback.
WORKOS_API_HOSTNAME=
WORKOS_API_HTTPS=
WORKOS_API_PORT=
